# ---- Python ----
__pycache__/
*.pyc
.venv/

# ---- Logs / captures / runtime dumps ----
*.log
*.log.prev
logcat*.txt
mitm.out
server/titan_server.log*
server/bundle_traffic.log*

# ---- Runtime player state (per-account saves, regenerated) ----
server/accounts/
server/player_state/*.bak-*
*.bak-*

# ---- Generated design cache (rebuilt from the design pack) ----
server/design_cache/
server/design_cache.*.bak/
server/build/

# ---- Large binary game assets (not source; distributed out-of-band) ----
server/patch_root/
*.ab
server/Android
server/Android_manifest.ab

# ---- Reverse-engineering working data (IDA dbs, extracted APKs, il2cpp dumps) ----
re/apk/
re/apk227/
re/il2cpp/
re/il2cpp227/
re/mars-java/
*.i64
*.idb

# ---- Built / signed APKs and the signing key (back these up separately!) ----
apkpatch/*.apk
apkpatch/*.idsig
*.keystore
# Asset tars and superseded design packs staged for release
apkpatch/*.tar
apkpatch/old_packs/

# ---- hostapp: gradle build output + stageServer-generated python copy ----
hostapp/app/build/
hostapp/build/
hostapp/.gradle/
hostapp/local.properties
hostapp/app/src/main/python/sevensins/

# ---- hostapp in-app updater: build_hostapp_update.py's output, served for the app to pull
hostapp_update/
# The update channel (owner/name of the release repo) is deliberately never committed --
# see hostapp/README.md. hostapp/local.properties is already ignored above.
tools/update_channel.txt

# ---- IDA MCP scratch ----
.ida-mcp/

# ---- Local proxy certs / private keys ----
certs/

# Release payloads built by hand (APKs + 2.5 GB asset tar)
dist/

# ---- Banner art extracted from the bundles (43MB, re-extractable) ----
banner_art/

# Compiled battle specs are build artifacts of tools/compile_skills.py -- regenerate
# rather than diffing 12 MB of generated JSON. The per-cast split keeps individual
# files readable when you do want to inspect one.
server/battle_data/skills/
server/battle_data/cinematic_swings.json
# Likewise tools/compile_statuses.py.
server/battle_data/statuses.json

# Generated artifacts that quote the game's own text verbatim -- skill_effects.json keeps
# unmatched clauses in `unparsed`, status_catalog.json keeps each status's description in
# `raw`, and avg_decisions.json holds scene dialogue. Nothing in server/ reads any of them
# at runtime; regenerate with tools/parse_skills.py, tools/extract_status_catalog.py and
# tools/avg_decisions.py --json. Their durable conclusions are already baked into code
# (karma.py's KARMA_DECISION_TIER, for one).
server/battle_data/skill_effects.json
server/battle_data/status_catalog.json
docs/avg_decisions.json

# The legacy proxy leaf cert is a symlink into the ignored certs/ dir and its target
# carries a PRIVATE KEY (load_cert_chain needs one). Generate it locally; never commit it.
tools/legacy_proxy/uj_leaf.pem
